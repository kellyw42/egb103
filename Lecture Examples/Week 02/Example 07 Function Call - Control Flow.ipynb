    "import math\n",
    "\n",
    "def sqrt(N) :\n",
    "    return math.sqrt(N)\n",
    "\n",
    "def compute_current(power, resistance) :\n",
    "    current = sqrt(power / resistance)\n",
    "    return current\n",
    "\n",
    "I1 = compute_current(3, 7)\n",
    "\n",
    "I2 = compute_current(-4, 2)"
   ]
